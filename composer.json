{
    "name": "roundly-consulting/tickets-for-laravel",
    "description": "Headless helpdesk ticketing core: categories, swappable statuses, replies and internal notes, assignment, priorities, due dates, custom fields, guest requesters and optional projects.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "tickets",
        "helpdesk",
        "support-desk",
        "ticketing",
        "issue-tracker",
        "service-desk"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/tickets-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/tickets-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/auth": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "roundly-consulting/attributes-for-laravel": "^2.0",
        "roundly-consulting/comments-for-laravel": "^2.0",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/lifecycle-for-laravel": "^2.0",
        "roundly-consulting/media-library-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0",
        "roundly-consulting/query-builder-for-laravel": "^2.0",
        "roundly-consulting/sluggable-for-laravel": "^2.0",
        "roundly-consulting/translatable-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "suggest": {
        "roundly-consulting/teams-for-laravel": "Assign tickets to teams (a Team implementing Contracts\\Assignee).",
        "roundly-consulting/permissions-for-laravel": "Agent roles that satisfy the tickets.* Gate abilities.",
        "roundly-consulting/metrics-for-laravel": "Ticket dashboards and trends."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Tickets\\": "src/",
            "RoundlyConsulting\\Tickets\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Tickets\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Tickets\\TicketsServiceProvider"
            ],
            "aliases": {
                "Tickets": "RoundlyConsulting\\Tickets\\Facades\\Tickets"
            }
        }
    }
}
